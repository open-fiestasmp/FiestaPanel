{
  "id": "episode_world_archiver",
  "name": "Episode World Archiver & Archive.org Publisher",
  "version": "1.0.0",
  "author": "FiestaSMP Team",
  "description": "Capture before and after world state snapshots for each SMP episode, create clean zip archives, upload to Internet Archive (archive.org), and synchronize world download releases with Google Calendar & Event Manager scheduled date/time.",
  "icon": "fa-solid fa-clapperboard",
  "category": "Backup & Sync",
  "enabled": true,
  "entrypoint": "main.py",
  "settings_schema": [
    {
      "key": "archive_org_access_key",
      "label": "Internet Archive (archive.org) S3 Access Key",
      "type": "text",
      "default": "",
      "placeholder": "Get from archive.org/account/s3.php"
    },
    {
      "key": "archive_org_secret_key",
      "label": "Internet Archive (archive.org) S3 Secret Key",
      "type": "password",
      "default": "",
      "placeholder": "S3 secret key"
    },
    {
      "key": "archive_org_collection",
      "label": "Internet Archive Collection",
      "type": "text",
      "default": "opensource",
      "placeholder": "opensource or custom collection"
    },
    {
      "key": "item_prefix",
      "label": "Item Identifier Prefix",
      "type": "text",
      "default": "fiestasmp_episode_",
      "placeholder": "fiestasmp_episode_"
    },
    {
      "key": "include_overworld",
      "label": "Include Overworld (world/)",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "include_nether",
      "label": "Include The Nether (world_nether/)",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "include_the_end",
      "label": "Include The End (world_the_end/)",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "auto_upload_ia",
      "label": "Auto-Upload to Internet Archive after Zipping",
      "type": "checkbox",
      "default": false
    },
    {
      "key": "broadcast_on_release",
      "label": "Broadcast in Minecraft Chat upon Scheduled Release",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "discord_webhook_url",
      "label": "Discord Announcement Webhook URL",
      "type": "text",
      "default": "",
      "placeholder": "https://discord.com/api/webhooks/..."
    },
    {
      "key": "google_calendar_feed_url",
      "label": "Google Calendar iCal / ICS Feed URL",
      "type": "text",
      "default": "",
      "placeholder": "https://calendar.google.com/calendar/ical/.../basic.ics"
    }
  ],
  "default_settings": {
    "archive_org_access_key": "",
    "archive_org_secret_key": "",
    "archive_org_collection": "opensource",
    "item_prefix": "fiestasmp_episode_",
    "include_overworld": true,
    "include_nether": true,
    "include_the_end": true,
    "auto_upload_ia": false,
    "broadcast_on_release": true,
    "discord_webhook_url": "",
    "google_calendar_feed_url": ""
  },
  "ui_slots": {
    "tab": {
      "title": "Episode World Archiver",
      "icon": "fa-solid fa-clapperboard",
      "description": "Capture Pre/Post recording world states, upload to Internet Archive, and release world downloads scheduled with Google Calendar."
    }
  }
}
