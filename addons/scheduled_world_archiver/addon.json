{
  "id": "scheduled_world_archiver",
  "name": "Scheduled World Archiver & Multi-Cloud Publisher",
  "version": "1.1.0",
  "author": "FiestaSMP Team",
  "description": "Capture world snapshots for any scheduled purpose (episodes, milestones, automated releases, backups), package into optimized zips, publish to GitHub Releases, Internet Archive, Cloudflare R2 / AWS S3, or custom endpoints, and synchronize releases with any schedule or calendar.",
  "icon": "fa-solid fa-cloud-arrow-up",
  "category": "Backup & Sync",
  "enabled": true,
  "entrypoint": "main.py",
  "settings_schema": [
    {
      "key": "default_cloud_target",
      "label": "Default Cloud Upload Destination",
      "type": "select",
      "options": ["archive_org", "github", "s3", "custom_post", "local"],
      "default": "archive_org"
    },
    {
      "key": "github_token",
      "label": "GitHub Personal Access Token",
      "type": "password",
      "default": "",
      "placeholder": "ghp_... with repo/contents:write scope"
    },
    {
      "key": "github_repo",
      "label": "GitHub Repository (owner/repo)",
      "type": "text",
      "default": "",
      "placeholder": "e.g. open-fiestasmp/world-downloads"
    },
    {
      "key": "github_tag_prefix",
      "label": "GitHub Release Tag Prefix",
      "type": "text",
      "default": "v",
      "placeholder": "v or release-"
    },
    {
      "key": "archive_org_access_key",
      "label": "Internet Archive (archive.org) S3 Access Key",
      "type": "text",
      "default": "",
      "placeholder": "Get from archive.org/account/s3.php"
    },
    {
      "key": "archive_org_secret_key",
      "label": "Internet Archive (archive.org) S3 Secret Key",
      "type": "password",
      "default": "",
      "placeholder": "S3 secret key"
    },
    {
      "key": "archive_org_collection",
      "label": "Internet Archive Collection",
      "type": "text",
      "default": "opensource",
      "placeholder": "opensource or custom collection"
    },
    {
      "key": "item_prefix",
      "label": "Archive.org Item Identifier Prefix",
      "type": "text",
      "default": "fiestasmp_world_",
      "placeholder": "fiestasmp_world_"
    },
    {
      "key": "s3_endpoint_url",
      "label": "Custom S3 / Cloudflare R2 Endpoint URL",
      "type": "text",
      "default": "",
      "placeholder": "https://<accountid>.r2.cloudflarestorage.com or https://s3.amazonaws.com"
    },
    {
      "key": "s3_bucket_name",
      "label": "S3 / R2 Bucket Name",
      "type": "text",
      "default": "",
      "placeholder": "e.g. fiestasmp-world-downloads"
    },
    {
      "key": "s3_access_key",
      "label": "S3 / R2 Access Key ID",
      "type": "text",
      "default": "",
      "placeholder": "Access Key ID"
    },
    {
      "key": "s3_secret_key",
      "label": "S3 / R2 Secret Access Key",
      "type": "password",
      "default": "",
      "placeholder": "Secret Access Key"
    },
    {
      "key": "s3_region",
      "label": "S3 / R2 Region",
      "type": "text",
      "default": "auto",
      "placeholder": "auto or us-east-1"
    },
    {
      "key": "s3_public_base_url",
      "label": "S3 / R2 Public Download Base URL",
      "type": "text",
      "default": "",
      "placeholder": "https://pub-...r2.dev or https://dl.yourdomain.com"
    },
    {
      "key": "custom_post_url",
      "label": "Custom HTTP Upload Endpoint URL",
      "type": "text",
      "default": "",
      "placeholder": "https://files.yourdomain.com/api/upload"
    },
    {
      "key": "custom_post_auth_header",
      "label": "Custom HTTP Authorization Header Value",
      "type": "password",
      "default": "",
      "placeholder": "Bearer token or Api-Key"
    },
    {
      "key": "include_overworld",
      "label": "Include Overworld (world/)",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "include_nether",
      "label": "Include The Nether (world_nether/)",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "include_the_end",
      "label": "Include The End (world_the_end/)",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "auto_upload_cloud",
      "label": "Auto-Upload to Cloud after Zipping",
      "type": "checkbox",
      "default": false
    },
    {
      "key": "recurring_snapshot_interval",
      "label": "Automated Recurring Snapshot Interval",
      "type": "select",
      "options": ["disabled", "6h", "12h", "24h", "7d"],
      "default": "disabled"
    },
    {
      "key": "google_calendar_feed_url",
      "label": "Google Calendar iCal / ICS Feed URL",
      "type": "text",
      "default": "",
      "placeholder": "https://calendar.google.com/calendar/ical/.../basic.ics"
    },
    {
      "key": "broadcast_on_release",
      "label": "Broadcast in Minecraft Chat upon Scheduled Release",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "discord_webhook_url",
      "label": "Discord Announcement Webhook URL",
      "type": "text",
      "default": "",
      "placeholder": "https://discord.com/api/webhooks/..."
    }
  ],
  "default_settings": {
    "default_cloud_target": "archive_org",
    "github_token": "",
    "github_repo": "",
    "github_tag_prefix": "v",
    "archive_org_access_key": "",
    "archive_org_secret_key": "",
    "archive_org_collection": "opensource",
    "item_prefix": "fiestasmp_world_",
    "s3_endpoint_url": "",
    "s3_bucket_name": "",
    "s3_access_key": "",
    "s3_secret_key": "",
    "s3_region": "auto",
    "s3_public_base_url": "",
    "custom_post_url": "",
    "custom_post_auth_header": "",
    "include_overworld": true,
    "include_nether": true,
    "include_the_end": true,
    "auto_upload_cloud": false,
    "recurring_snapshot_interval": "disabled",
    "google_calendar_feed_url": "",
    "broadcast_on_release": true,
    "discord_webhook_url": ""
  },
  "ui_slots": {
    "tab": {
      "title": "Scheduled World Archiver",
      "icon": "fa-solid fa-cloud-arrow-up",
      "description": "Capture world snapshots for any scheduled purpose, publish to GitHub Releases, Internet Archive, or Cloudflare R2 / S3, and synchronize releases."
    }
  }
}
